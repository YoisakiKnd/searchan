# Load manually: set -a; source .env; set +a
# Only intended providers are called; selected services may receive queries.
SEARCHAN_PROVIDERS=ddg
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
SEARXNG_ENDPOINT=http://localhost:8080/search
SEARXNG_ENGINES=duckduckgo,bing

# Separate optional fallback reader; supplier charges may apply.
JINA_READER_ENABLED=false
# JINA_READER_ENDPOINT=https://r.jina.ai/

# Full Chat Completions endpoint. Empty = extractive mode.
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
MODEL_JSON_MODE=true
MODEL_MAX_TOKENS=2400
SEARCHAN_MODEL_PLAN=true
SEARCHAN_MODEL_VERIFY=true

TYPST_BIN=typst
# Colon-separated on Linux/macOS; semicolon-separated on Windows.
# TYPST_FONT_PATHS=/usr/share/fonts/opentype/noto
SEARCHAN_DATA_DIR=data
SEARCHAN_LISTEN=127.0.0.1:8090
SEARCHAN_WORKERS=2
SEARCHAN_QUEUE_SIZE=32
SEARCHAN_SEARCH_CALLS=6
SEARCHAN_MAX_PAGES=8
SEARCHAN_SEARCH_CONCURRENCY=3
SEARCHAN_READ_CONCURRENCY=3
SEARCHAN_MAX_EVIDENCE=12
SEARCHAN_TASK_TIMEOUT=90s
SEARCHAN_RESEARCH_TIMEOUT=45s
SEARCHAN_SEARCH_TIMEOUT=8s
SEARCHAN_READ_TIMEOUT=10s
SEARCHAN_PLANNING_TIMEOUT=4s
SEARCHAN_MODEL_TIMEOUT=18s
GOMEMLIMIT=96MiB

# serve needs at least one official bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# First release: restrict access unless deliberately made public.
SEARCHAN_PUBLIC=false
# Comma-separated platform:id entries; an allowed user OR chat may search.
# SEARCHAN_ALLOWED_USERS=telegram:123456789
SEARCHAN_ALLOWED_USERS=
SEARCHAN_ALLOWED_CHATS=
SEARCHAN_MAX_USER_TASKS=2
SEARCHAN_MAX_CHAT_TASKS=4
SEARCHAN_SHUTDOWN_TIMEOUT=30s
# Required only by compose.production.yaml, hostname without https:// or paths.
SEARCHAN_DOMAIN=
QQ_APP_ID=
QQ_APP_SECRET=

# Trusted operator overrides, never from chat input.
# TAVILY_ENDPOINT=https://api.tavily.com/search
# EXA_ENDPOINT=https://api.exa.ai/search
# BRAVE_ENDPOINT=https://api.search.brave.com/res/v1/web/search
# JINA_ENDPOINT=https://s.jina.ai/
# DDG_ENDPOINT=https://html.duckduckgo.com/html/
# TELEGRAM_API_ENDPOINT=https://api.telegram.org
# QQ_API_ENDPOINT=https://api.sgroup.qq.com
# QQ_TOKEN_ENDPOINT=https://bots.qq.com/app/getAppAccessToken
